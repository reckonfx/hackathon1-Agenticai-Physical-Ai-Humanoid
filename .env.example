# Physical AI & Humanoid Robotics Textbook - Environment Variables

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=https://github.com/your-username/your-repo-name.git
GITHUB_USERNAME=your_github_username

# Google Gemini Configuration (for RAG chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Translation API (for Urdu translation)
GOOGLE_CLOUD_TRANSLATION_API_KEY=your_google_cloud_translation_api_key

# Qdrant Vector Database Configuration
QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key

# Neon PostgreSQL Configuration
NEON_DB_URL='your_neon_db_connection_string'

# Context7 MCP Configuration
CONTEXT7_MCP_PATH=path_to_your_context7_directory
CONTEXT7_MCP_URL=stdio  # Using stdio transport for Context7 MCP
CONTEXT7_API_KEY=your_context7_api_key

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Docusaurus Frontend Configuration
FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://your-domain.com

# Application Settings
APP_ENV=development  # development, staging, or production
LOG_LEVEL=info
DEBUG=false

# Optional: Cloud Deployment (Render/Railway/etc.)
DEPLOYMENT_PLATFORM=render  # render, railway, etc.
DEPLOYMENT_API_KEY=your_deployment_platform_api_key

# Optional: Monitoring Services
MONITORING_API_KEY=your_monitoring_service_api_key
LOGGING_SERVICE_URL=your_logging_service_url

# Optional: Domain and SSL
CUSTOM_DOMAIN=your-custom-domain.com
SSL_CERTIFICATE_PATH=path_to_ssl_certificate